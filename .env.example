# Supabase Configuration
# 이 앱은 Supabase URL과 anon key가 없으면 실행되지 않습니다.
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Kakao Login Configuration
# 카카오 디벨로퍼스에서 발급받은 JavaScript 키를 입력하세요.
VITE_KAKAO_APP_KEY=your_kakao_javascript_key

# Supabase API URL (로컬: http://localhost:54321, 프로덕션: Supabase 대시보드에서 확인)
VITE_SUPABASE_URL=http://localhost:54321
VITE_PUBLIC_API_BASE_URL=http://localhost:8080

# Supabase Edge Function CORS 허용 Origin 목록 (쉼표로 구분)
# 커스텀 도메인을 쓰면 Supabase Function secret ALLOWED_ORIGINS에도 같은 값을 설정하세요.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-domain.vercel.app

# Naver Maps API Key (네이버 클라우드 플랫폼 > Application > Client ID)
VITE_NAVER_CLIENT_ID=your_naver_client_id

# 아래 값은 서버/Edge Function secret 전용입니다. VITE_ 접두사를 붙이지 마세요.
NAVER_CLIENT_ID=your_naver_server_client_id
NAVER_SECRET_KEY=your_naver_server_secret_key

# seedDatabase를 실행할 때만 사용하는 초기 관리자 정보 (비밀번호 12~72자)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_a_unique_password

# 표준 Web Push 서비스 외에 허용할 호스트가 있을 때만 쉼표로 추가
PUSH_ALLOWED_HOSTS=
