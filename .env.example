# Supabase Configuration
# 아래 값들은 utils/supabase/info.tsx 파일 대신 환경 변수로 관리하고 싶을 때 사용하세요.
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Kakao Login Configuration
# 카카오 디벨로퍼스에서 발급받은 JavaScript 키를 입력하세요.
VITE_KAKAO_APP_KEY=your_kakao_javascript_key

# Supabase API URL (로컬: http://localhost:54321, 프로덕션: Supabase 대시보드에서 확인)
VITE_SUPABASE_URL=http://localhost:54321

# Naver Maps API Key (네이버 클라우드 플랫폼 > Application > Client ID)
VITE_NAVER_CLIENT_ID=your_naver_client_id
